# Copy to .env and fill in. Never commit .env.

# --- Site -------------------------------------------------------------
# A DNS name whose A record points at the droplet; Caddy gets a TLS cert for it.
SITE_DOMAIN=progent.example.org

# Password protection (Caddy basic auth). Generate the hash with ./make-password.sh
BASIC_AUTH_USER=hriday
# Paste the line printed by ./make-password.sh (keep the single quotes):
BASIC_AUTH_HASH=''

# --- Models -----------------------------------------------------------
# The Anthropic key goes in a file named .key next to this one (one line, git-ignored).
# Compose mounts it as a secret. Required for the attack lab; the rest of the site works
# without it (create an empty .key in that case, since Compose expects the file).
AGENT_MODEL=claude-sonnet-5-5
POLICY_MODEL=claude-sonnet-5-5

# Optional: adds gpt-4o-2024-08-06 (the paper's policy model) to the policy model list.
OPENAI_API_KEY=

# Optional: enables the TypeSafe Jev update gate.
TYPESAFE_API_KEY=
JEV_GATE_THRESHOLD=0.5

# --- Limits -----------------------------------------------------------
MAX_STEPS=14
MAX_CONCURRENT_RUNS=2
APPROVAL_TIMEOUT_S=600
